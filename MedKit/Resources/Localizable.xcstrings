  "strings": {
    "%@": {
      "comment": "The title of the PDF file that is shared.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "bho": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %@": {
      "comment": "The quantity of a medicine in stock, formatted to two decimal places. The argument is the string “%.2f”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "bho": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ %@": {
      "comment": "A text summarizing the dosage. The first argument is the dosage amount. The second argument is the dosage unit. The third argument is the dosage repetition.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "%1$@ %2$@ %3$@"
          }
        },
        "bho": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@ %@, %lld times %@": {
      "comment": "A text summarizing the dosage of a medicine, including the quantity, unit, and number of times it is repeated.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@, %3$lld times %4$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "%1$@ %2$@, %3$lld बार %4$@"
          }
        },
        "bho": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, %3$lld बेर %4$@"
          }
        }
      }
    },
